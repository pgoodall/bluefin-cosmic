##
# Default Brewfile for bluefin-cosmic
# Uncomment packages you want to install, or add your own.
# Users install via: ujust install-default-apps
##
tap "ublue-os/tap", trusted: { casks: ["chairlift"] }
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Use any Linux distribution inside your terminal
brew "distrobox"
# Handy way to save and run project-specific commands
brew "just"
# Language server for just
brew "just-lsp"
# Utility for managing network connections
brew "netcat"
# Port scanning utility for large networks
brew "nmap"
# Cross-shell prompt for astronauts
brew "starship"
# Vi 'workalike' with many additional features
brew "vim"
# Command-line interface for 1Password
cask "1password-cli"
vscode "1password.op-vscode"
# nerd fonts for extra symbols
cask "font-fira-code-nerd-font"
cask "font-meslo-lg-nerd-font"
cask "font-ubuntu-nerd-font"
# Set of tools to manage resources and applications hosted on Google Cloud
cask "gcloud-cli"
##
# VSCode plugins?
##
vscode "fill-labs.dependi"
vscode "github.vscode-github-actions"
vscode "ms-azuretools.vscode-containers"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode-remote.remote-ssh"
vscode "ms-vscode-remote.remote-ssh-edit"
vscode "ms-vscode.remote-explorer"
vscode "ms-vscode.remote-server"
vscode "nefrob.vscode-just-syntax"
vscode "pflannery.vscode-versionlens"
vscode "rust-lang.rust-analyzer"
vscode "tamasfe.even-better-toml"
vscode "tuttieee.emacs-mcx"
vscode "vadimcn.vscode-lldb"
# Change permissions for Flatpak apps
flatpak "com.github.tchx84.Flatseal"
# Ambient sounds app for focus
flatpak "com.rafaelmardojai.Blanket"
# Obvs
flatpak "com.spotify.Client"
##
# Cosmic apps
##
flatpak "dev.edfloreshz.Calculator"
flatpak "dev.edfloreshz.CosmicTweaks"
flatpak "dev.heppen.webapps" # This is awesome for web apps
# Add app icons to the workspace switcher
flatpak "io.github.crocodile.cosmic-ext-applet-workspace-icons", remote: "cosmic"
flatpak "org.fedoraproject.MediaWriter"
# GNOME Image Viewer
flatpak "org.gnome.Loupe"
# Backup - might replace with a rust-based app
flatpak "org.gnome.World.PikaBackup"
flatpak "org.mozilla.firefox"
